@model WebBanThuocBVTV.Models.Sanpham;
<link rel="stylesheet" href="/css/Product/DetailProduct.css" />

<div class="detail_product-container">
	<!-- Product Grid -->
	<div class="product-grid">
		<!-- Product Image Section -->
		<div class="product-image-section">
			@if (Model.Hinhanhs?.Any() == true)
			{
				var hinhanhs = Model.Hinhanhs.ToList();

				<div class="product-image-main">
					<img src="@hinhanhs[0].Url" alt="Thuốc trừ sâu X" class="product-image" />
				</div>
				<div class="product-image-thumbnails">
					@for (int idx = 1; idx < hinhanhs?.Count; idx++)
					{
						var img = hinhanhs[idx];
						<img src="@img.Url" alt="Hình @(idx + 1)" class="thumbnail" />
					}
				</div>
			}
			else
			{
				<div class="product-image-main">
					<img src="<img src=" https: //thumbs.dreamstime.com/blog/2012/07/uploading-technical-error-76339-image21759953.jpg" alt="Thuốc trừ sâu X" class="product-image">" alt="Thuốc trừ sâu X" class="product-image" />
				</div>
				<div class="product-image-thumbnails">
				</div>
			}

		</div>

		<!-- Product Info Section -->
		<form class="product-info-section" asp-action="IndexFromDetail" asp-controller="Order" asp-area="Customer">
			<input name="maSp" id="maSp" value="@Model.MaSanPham" type="hidden" />
			<h1 class="product-title">@Model.MaNhomSpNavigation.TenNhomSp @Model.TenSanPham</h1>
			<div class="product-price-section">
				<span class="product-price">@String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:N0}", Model.Gia) VNĐ</span>
			</div>
			<div class="quantity-section">
				<button type="button" class="quantity-btn decrease_quality" onclick="decreaseQuality(this)">-</button>
				<input name="soLuong" type="number" id="quantity-input" value="1" min="1" onblur="changeQuality(this)" />
				<button type="button" class="quantity-btn increase_quality" onclick="increaseQuality(this)">+</button>
			</div>
			<div class="product-actions">
				@if (Model.SoLuong > 0)
				{
					<button class="add-to-cart" type="button" onclick="addGioHang()">Thêm vào giỏ hàng</button>
					<button class="buy-now" type="submit">Mua ngay</button>
				}
				else
				{
					<button type="button" class="btn btn-secondary" disabled>Hết hàng</button>
				}
			</div>
		</form>
	</div>

	<!-- Product Description Section -->
	@Html.Partial("_DecriptionDetailProduct", Model)

	<!-- Comments and Ratings Section -->
	@Html.Partial("_ReviewProduct", Model)
</div>
<script src="~/js/Customer/Product/Detail.js"></script>
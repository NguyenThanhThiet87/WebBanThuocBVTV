@{
}
@using X.PagedList;
@using X.PagedList.Mvc.Core;
@model IPagedList<WebBanThuocBVTV.Models.Sanpham>
@using System.Globalization
<div class="row row-cols-1 row-cols-md-4 g-4">
	@foreach (var sp in Model)
	{
		int sumEvaluate = 0;
		int sumProductBuyed = 0;
		<a href="@Url.Action("DetailProduct","Product",new {area = "Customer", maSp=@sp.MaSanPham})" style="text-decoration:none; color: black;">
			<div class="col">
				<div class="card">
					<img src="@sp.Hinhanhs.FirstOrDefault()?.Url" class="card-img-top" alt="error_img">
					<div class="card-body">
						<h5 class="card-title">@(CultureInfo.CurrentCulture.TextInfo.ToTitleCase(sp.TenSanPham.ToLower() ?? "Không tên"))</h5>
						<h5 class="card-text" style="color: red">@(String.Format("{0:N0}", @sp?.Gia)) vnđ</h5>
						<p>
							<i class="fa-solid fa-star" style="color: #FFD43B;"></i>

							@foreach (var evaluate in sp.Binhluans)
							{
								sumEvaluate += evaluate.MaDanhGia;
							}
							@(sumEvaluate == 0 ? 5 : sumEvaluate / sp.Binhluans.Count)
							@foreach (var order in sp.DonhangSanphams)
							{
								if (order.MaDonHangNavigation.MaTrangThai == "CMP")
								{
									sumProductBuyed += order.SoLuongDatMua;
								}
							}
							Đã bán @(sumProductBuyed >= 1000 ? sumProductBuyed / 1000 + "k" : sumProductBuyed)
						</p>
					</div>
				</div>
			</div>
		</a>
	}
</div>
<br />
<br />
@if (ViewBag.PageCount > 0)
{
	<nav aria-label="Page navigation" class="pt-3">
		<ul class="pagination">
			<li class="page-item"><a class="page-link" onclick="pageList(this, @ViewBag.PageNumber, @ViewBag.PageCount)">Previous</a></li>
			@{
				int i = ViewBag.PageNumber <= 6 ? 1 : (ViewBag.PageNumber / 6) * 6;
				int end = i + 5;
				while (i <= ViewBag.PageCount && i <= end)
				{
					<li class="page-item @(i == ViewBag.PageNumber ? "active":"")"><a class="page-link" onclick="pageList(this)">@i</a></li>
					i++;
				}
			}
			<li class="page-item"><a class="page-link" onclick="pageList(this, @ViewBag.PageNumber, @ViewBag.PageCount)">Next</a></li>
		</ul>
	</nav>
}
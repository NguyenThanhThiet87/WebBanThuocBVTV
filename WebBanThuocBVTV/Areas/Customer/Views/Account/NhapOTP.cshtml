@{
}
<link href="~/css/Account/GuiEmailOTP.css" rel="stylesheet" />
<div class="modal fade" id="GuiEmailOTPmodal" aria-hidden="true" aria-labelledby="GuiEmailOTPmodal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="guimaotp-container modal-content">
            <form class="verify-code-form" asp-action="VerifyOTP" asp-controller="Login">
                <p>Nhập mã của bạn để xác nhận email</p>
                <input name="otpCode" type="text" placeholder="Nhập mã của bạn" required>
                <input name="email" value="@ViewBag.Email" style="display:none" />
                <button type="submit">Xác nhận</button>
            </form>
            <p>
                <form asp-action="NhapMaOTP" asp-controller="Login" method="post">
                    <input name="email" value="@ViewBag.Email" type="hidden" />
                    <input name="flow" value="@(Context.Session.GetString("Flow") ?? "Register")" type="hidden" />
                    <button type="submit">Gửi lại</button>
                </form>
                | <a asp-action="Register" asp-controller="Login">Quay lại</a>
            </p>
        </div>
    </div>
</div>



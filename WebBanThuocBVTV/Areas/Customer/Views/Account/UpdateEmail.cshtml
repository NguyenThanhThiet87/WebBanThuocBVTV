@{
}
<link href="~/css/Account/UpdateEmail.css" rel="stylesheet" />
<div class="updateEmail-container">
	<div class="card">
		<div class="card-header">
			<h4 class="mb-0">Quản lý tài khoản</h4>
			<small>Cập nhật Email</small>
		</div>

		<div class="card-body">
			<div>
				<!-- Email Input -->
				<div class="mb-3">
					<label for="email" class="form-label">Cập nhật Email</label>
					<div class="input-group">
						<input name="email" type="email" class="form-control" id="email_updateEmail" placeholder="Nhập email mới" value="@(ViewBag.Email??"")" required>
						<button class="btn btn-success" id="btn-sendcode" type="button" onclick="sendOTP()">
							Gửi mã
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- Modal -->
<div class="modal fade" id="verifyModal" tabindex="-1" aria-labelledby="verifyModalLabel" data-bs-backdrop="static" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content" id="modal-container">
		</div>
	</div>
</div>
<script src="~/js/Customer/Account/UpdateEmail.js"></script>
@{
}
<link href="~/css/Account/UpdateEmail.css" rel="stylesheet" />
 <div class="updateEmail-container">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">Quản lý tài khoản</h4>
                <small>Cập nhật Email</small>
            </div>
            
            <div class="card-body">
            <form asp-action="VerifyOTP" asp-controller="Account">
                    <!-- Email Input -->
                    <div class="mb-3">
                        <label for="email" class="form-label">Cập nhật Email</label>
                        <div class="input-group">
                        <input name="email" type="email" class="form-control" id="email_updateEmail" placeholder="Nhập email mới" value="@(ViewBag.Email??"")" required>
                        <button class="btn btn-success" id="btn-sendcode" type="button" onclick="SendOTP(this)">
                                Gửi mã
                        </button>
                        </div>
                    </div>

                    <!-- OTP Input -->
                    <div class="mb-3">
                        <label for="otp" class="form-label">Nhập mã OTP</label>
                        <div class="input-group">
                        <input name="otpCode" type="text" class="form-control" id="otp" placeholder="Vui lòng nhập mã OTP" maxlength="6" value="@(ViewBag.OtpCode??"")" required>
                            <button class="btn btn-success" type="submit">
                                Cập nhật
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

<script>
    SendOTP = function(button)
    {
        var formData = {email: $("#email_updateEmail").val()};
        $.ajax({
              type: "POST",
              url: '@Url.Action("SendOTP_Json", "Account")',
                    data: formData,
                    success: function (result) {
                           document.getElementById("btn-sendcode").disabled = true;
                           // Kích hoạt lại sau 6 giây
                           setTimeout(() => {
                                  document.getElementById("btn-sendcode").disabled = false;
                           }, 60000);
                        alert("Gui email thanh cong"+result.Message)
                    },
                    error: function (xhr, status, error) {
                        alert("Error: " + xhr.responseText);
                    }
                });
    }

</script>
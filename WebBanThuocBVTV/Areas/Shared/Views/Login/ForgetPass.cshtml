@{
}
<link href="~/css/Login/ForgetPass.css" rel="stylesheet" />
<div class="forgetpass-container">
	<div class="forgot-password-form">
		<h2>Quên mật khẩu</h2>
		<p>Nhập email của bạn để nhận liên kết đặt lại mật khẩu.</p>
		<input id="email" name="email" type="text" placeholder="Nhập email của bạn" required>
		<button onclick="sendOTP()" data-bs-toggle="modal" data-bs-target="#verifyModal">Gửi yêu cầu</button>
		<p><a asp-controller="Login" asp-action="Index">Quay lại</a></p>
	</div>
</div>
<!-- Modal -->
<div class="modal fade" id="verifyModal" tabindex="-1" aria-labelledby="verifyModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content" id="modal-container">
		</div>
	</div>
</div>

<script>
	var sendOTP = function()
	{
		showLoading("");
		var modalContainer = document.getElementById("modal-container");

		var email = document.getElementById("email").value;
		$.ajax({
			url:"@Url.Action("SendOTPEmailForForget", "Login", new { area = "Shared" })",
			method: "POST",
			data: {email},
			success: function(res)
			{
				modalContainer.innerHTML = res;
				hideLoading();
			},
			error: function(err)
			{
				console.log(err);
				hideLoading();
			}
		})
	}
	var verifyEmail=function()
		{
			var email = document.getElementById("email").value;

			var otp =""
			var inputs = document.getElementsByClassName("otp-input");

			for(var i =0;i<inputs.length;i++)
			{
				otp+=inputs[i].value;
			}

			$.ajax({
				url:"@Url.Action("VerifyOTP", "Login", new { area = "Shared" })",
				method:"post",
				data:{otpCode:otp, email:email},
				success:function(res){
					hideLoading();
					if(res.success)
					{
						showToast('success', 'Xác thực thành công! Đang chuyển trang...');
						// Đợi một chút để người dùng đọc toast rồi mới chuyển trang
					    setTimeout(function() {
						      window.location.href = res.redirectUrl;
					    }, 1500); // Chuyển trang sau 1.5 giây

						var verifyBtn = document.getElementById("verifyEmailBtn");
						verifyBtn.style.display="none";
						modal.hide();
					}else
					{
						showToast('warning',res.message);
					}
				},
				error:function(res)
				{
					hideLoading();
					showToast('error',res.message);
				}
			}
			)
		}
</script>

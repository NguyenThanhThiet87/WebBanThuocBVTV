
<link rel="stylesheet" href="~/css/Login/Index.css">
<div class="login-container">
    <form class="login-form" asp-action="LoginAccount" asp-controller="Login" asp-area="Shared" onsubmit="showLoading('')">
        <h2>Đăng nhập tài khoản</h2>
        <input name="email" type="email" placeholder="Nhập email của bạn" required>
        
        <div class="input-wrapper">
            <input id="password" name="password" type="password" placeholder="Nhập mật khẩu" required>
            <span class="toggle-password">
                <i class="fa fa-eye" onclick="togglePass('display')"></i>
                <i class="fa fa-eye-slash d-none" onclick="togglePass('hidden')"></i>
            </span>
        </div>
        <button type="submit" >Đăng nhập</button>
        <p><a asp-controller="Login" asp-action="ForgetPass">Quên mật khẩu?</a>   |   <a asp-controller="Login" asp-action="Register">Đăng ký ngay</a></p>
        <div class="social-login">
            <a class="google"  asp-action="GoogleLogin" asp-controller="Login">Google</a>
        </div>
    </form>
</div>

@using WebBanThuocBVTV.Helper
@model List<WebBanThuocBVTV.Models.Nguoidung>
@{
}
<link href="~/css/Admin/ManageCustomer/_ListCustomer.css" rel="stylesheet" />
<link href="/css/Admin/ManageCustomer/Index.css" rel="stylesheet" />
<div class="manage_customer-container">
	<h1 class="page-title">Quản Lý Khách Hàng</h1>

	<div class="content-container">
		<!-- Thao tác nhanh -->
		<div class="actions-section">
			<h2 class="actions-title">Thao tác nhanh</h2>
			<div class="actions-grid">
				<a class="action-btn" href="@Url.Action("AddCustomer","ManageCustomer",new{area="Admin"})">
					<i class="fa-solid fa-plus"></i>
					Thêm khách hàng mới
				</a>
			</div>
		</div>

		<!-- Bảng khách hàng -->
		<div class="customer_section-container">

			<div class="table-header">
				<h2 class="table-title">Danh sách khách hàng</h2>
				<div class="active-filters" id="activeFilters" style="display: none;">
					<strong>Bộ lọc đang áp dụng:</strong>
					<div id="filterTags"></div>
				</div>

				<div class="sort-options">
					<label>Sắp xếp theo:</label>
					<select class="sort-select" id="sortSelect" asp-items="Html.GetEnumSelectList<SortOptionsCustomer>()" onchange="applyFilters()">
					</select>
				</div>

				<div class="search-container">
					<input type="text" class="search-input" placeholder="Tìm kiếm khách hàng..." value="" id="searchInput">
					<button class="search-btn" onclick="applyFilters()">
						<i class="fa-solid fa-magnifying-glass"></i>
						Tìm kiếm
					</button>
				</div>
			</div>

			<div class="table-content">
				<div class="filter-sidebar">
					<h3 style="margin-bottom: 20px; color: #2c3e50;">
						<i class="fa-solid fa-filter"></i>
						Bộ lọc
					</h3>
					<div class="filter-section">
						<div class="filter-title">
							<i class="fa-solid fa-user-tag"></i>
							Loại khách hàng
						</div>
						<select class="sort-select" id="categorySelect" asp-items="Html.GetEnumSelectList<CategoryCustomer>()">
						</select>
					</div>
					<div class="filter-section">
						<div class="filter-title">
							<i class="fa-solid fa-mars-and-venus"></i> 
							Giới tính
						</div>
						<select class="sort-select" id="genderSelect" asp-items="Html.GetEnumSelectList<GenderOptions>()">
						</select>
					</div>

					<!-- Số lượng tồn kho -->
					<div class="filter-section">
						<div class="filter-title">
							<i class="fa-solid fa-calendar-days"></i>
							Ngày tạo
						</div>
						<select class="sort-select" id="createAtSelect" asp-items="Html.GetEnumSelectList<CreateAtOptions>()">
						</select>
					</div>

					<div class="filter-actions">
						<button class="btn-apply" onclick="applyFilters()">Áp dụng</button>
						<button class="btn-reset" onclick="resetFilters()">Đặt lại</button>
					</div>
				</div>

				<div class="customer-table">

				</div>
			</div>
		</div>
	</div>

	<!-- Modal -->
	<div class="modal fade" id="detail_customerModal" tabindex="-1" aria-labelledby="detail_customerModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-lg">
			<div class="modal-content" id="modal-container">
			</div>
		</div>
	</div>
</div>
<script src="~/js/Admin/ManageCustomer/Index.js"></script>
<script src="~/js/Admin/ManageCustomer/_ListCustomer.js"></script>
<script src="~/js/Admin/ManageCustomer/_DetailCustomer.js"></script>
@model IPagedList<WebBanThuocBVTV.Models.Nguoidung>
@using X.PagedList;
@using X.PagedList.Mvc.Core;
@using System.Globalization
@if(Model.Count > 0)
{
	<table class="customer-table">
		<thead>
			<tr>
				<th>ID</th>
				<th>Tên</th>
				<th>Giới tính</th>
				<th>Email</th>
				<th>Địa chỉ</th>
				<th>Ngày tạo</th>
				<th>Thao tác</th>
			</tr>
		</thead>
		<tbody id="customerTableBody">
			@foreach (var item in Model)
			{
				<tr>
					<td>#@item.MaNd</td>
					<td>@item.HoTen</td>
					<td>@item.DisplayGioiTinh</td>
					<td>@item.Email</td>
					<td>@(item.DiaChi.Length>12?item.DiaChi.Replace(item.DiaChi.Substring(12), "..."): item.DiaChi)</td>
					<td>@item.NgayTao.Date.ToString("dd/MM/yyyy")</td>
					<td>
						<div class="action-buttons">
							<button class="btn-view btn btn-lg" data-bs-toggle="modal" data-bs-target="#detail_customerModal" onclick="detailCustomer('@item.MaNd')">
								<i class="fas fa-eye me-2"></i>Xem
							</button>

							<button class="btn btn-delete" onclick="deleteCustomer('#001')">🗑️ Xóa</button>
						</div>
					</td>
				</tr>
			}
		</tbody>
	</table>
}else
{
	<lottie-player id="animation-empty-user" class="w-100 h-50" src="https://lottie.host/3fbc8aea-fdf2-4ce8-9a98-7a3de0c5cee5/No6vcVStET.json" background="##FFFFFF" speed="1" loop autoplay direction="1" mode="normal"></lottie-player>
	<p id="title_empty_order">Khách hàng không tồn tại</p>
}
@if(ViewBag.PageCount>0)
{
	<nav aria-label="Page navigation" class="pt-3">
		<ul class="pagination">
			<li class="page-item"><a class="page-link" onclick="pageList(this, @ViewBag.PageNumber, @ViewBag.PageCount)">Previous</a></li>
			@{
				int i = ViewBag.PageNumber <= 6 ? 1 : (ViewBag.PageNumber / 6) * 6;
				int end = i + 5;
				while (i <= ViewBag.PageCount && i <= end)
				{
					<li class="page-item @(i == ViewBag.PageNumber ? "active":"")"><a class="page-link" onclick="pageList(this)">@i</a></li>
					i++;
				}
			}
			<li class="page-item"><a class="page-link" onclick="pageList(this, @ViewBag.PageNumber, @ViewBag.PageCount)">Next</a></li>
		</ul>
	</nav>
}

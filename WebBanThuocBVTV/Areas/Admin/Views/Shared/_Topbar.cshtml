    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<link href="~/css/Admin/Share/_TopBar.css" rel="stylesheet" />
<div class="topbar">
	<button class="sidebar-toggle" id="sidebarToggle">
		<i class="fas fa-bars"></i>
	</button>
	<div class="topbar-center">
		<h6 class="mb-0">Chào mừng trở lại, Admin!</h6>
	</div>
	<div class="topbar-right">
		<div class="dropdown">
			<button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
				<i class="fas fa-bell"></i>
				<span class="badge bg-danger">3</span>
			</button>
			<ul class="dropdown-menu">
				<li><a class="dropdown-item" href="#">Đơn hàng mới</a></li>
				<li><a class="dropdown-item" href="#">Sản phẩm hết hàng</a></li>
				<li><a class="dropdown-item" href="#">Khách hàng phản hồi</a></li>
			</ul>
		</div>
		<div class="user-info">
			<div class="user-avatar">
				@if (ViewBag.Account?.Avatar != null)
				{
					<img name="avatar" src="@(ViewBag.Account?.Avatar??"")" alt="Alternate Text" class="avatar" />
				}
				else
				{
					<img name="avatar" src="https://static.vecteezy.com/system/resources/previews/024/183/502/original/male-avatar-portrait-of-a-young-man-with-a-beard-illustration-of-male-character-in-modern-color-style-vector.jpg" alt="Alternate Text" class="avatar" />
				}
			</div>
			<div>
				<div class="fw-bold">@(ViewBag.Account.HoTen)</div>
				<small class="text-muted">Quản trị viên</small>
			</div>
			<div class="dropdown">
				<button class="btn btn-link" type="button" data-bs-toggle="dropdown">
					<i class="fas fa-chevron-down"></i>
				</button>
				<ul class="dropdown-menu">
					<li><a class="dropdown-item" href="@Url.Action("Index","Account",new{area = "Admin"})">Hồ sơ</a></li>
					<li><a class="dropdown-item" href="#">Cài đặt</a></li>
					<li><hr class="dropdown-divider"></li>
					<li>
						<form asp-action="Logout" asp-controller="Account" method="post">
							<button id="logout-btn" class="btn" type="submit">Đăng xuất</button>
						</form>
					</li>
				</ul>
			</div>
		</div>
	</div>
</div>

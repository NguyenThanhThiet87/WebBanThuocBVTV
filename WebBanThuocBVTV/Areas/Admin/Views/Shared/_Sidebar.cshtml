@using WebBanThuocBVTV.Helper
@{
}
<link href="/css/Admin/Home/_Sidebar.css" rel="stylesheet" />
<div class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo">
            <i class="fas fa-seedling"></i>
        </div>
        <h4>AgriProtect</h4>
        <small>Admin Panel</small>
    </div>
    <nav class="sidebar-nav">
        <ul class="nav flex-column">
            <li class="nav-item">
                <a href="@Url.Action("Index", "Home", new { area = "Admin" })" class="nav-link @(ViewBag.CurrentSideBar == SideBar.TongQuan ? "active" : "")">
                    <i class="fas fa-tachometer-alt"></i>
                    <span>Tổng quan</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Index", "ManageProduct", new { area = "Admin" })" class="nav-link @(ViewBag.CurrentSideBar == SideBar.SanPham ? "active" : "")">
                    <i class="fas fa-boxes"></i>
                    <span>Sản phẩm</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewBag.CurrentSideBar == SideBar.DonHang ? "active" : "")" href="@Url.Action("Index", "ManageOrder", new { area = "Admin" })">
                    <i class="fas fa-shopping-cart"></i>
                    <span>Đơn hàng</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewBag.CurrentSideBar == SideBar.KhachHang ? "active" : "")" href="@Url.Action("Index", "ManageCustomer", new { area = "Admin" })">
                    <i class="fas fa-users"></i>
                    <span>Khách hàng</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link @(ViewBag.CurrentSideBar == SideBar.BinhLuan ? "active" : "")">
                    <i class="fas fa-tags"></i>
                    <span>Bình luận</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link @(ViewBag.CurrentSideBar == SideBar.KhoHang ? "active" : "")">
                    <i class="fas fa-warehouse"></i>
                    <span>Kho hàng</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link @(ViewBag.CurrentSideBar == SideBar.BaoCao ? "active" : "")">
                    <i class="fas fa-chart-line"></i>
                    <span>Báo cáo</span>
                </a>
            </li>
        </ul>
    </nav>
</div>
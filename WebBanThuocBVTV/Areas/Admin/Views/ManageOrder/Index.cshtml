@using WebBanThuocBVTV.Helper
@{
}
<link href="~/css/Admin/ManageOrder/Index.css" rel="stylesheet" />
<link href="~/css/Admin/ManageOrder/_DetailOrder.css" rel="stylesheet" />
<link href="~/css/Admin/ManageOrder/_ListOrder.css" rel="stylesheet" />
<div class="manage_order-container">
	<!-- Header -->
	<h1 class="page-title">Quản Lý Đơn Hàng</h1>

	<div class="content-container">
		<!-- Thống kê -->
		<div class="stats-grid">
			<div class="stat-card">
				<div class="stat-icon customers">👥</div>
				<div class="stat-value">@ViewBag.TongKh</div>
				<div class="stat-label">Tổng khách hàng</div>
				<div class="stat-change">↗ +8% so với tháng trước</div>
			</div>
			<div class="stat-card">
				<div class="stat-icon new">🆕</div>
				<div class="stat-value">@ViewBag.KhMoi</div>
				<div class="stat-label">Khách hàng mới</div>
				<div class="stat-change">↗ +12% so với tháng trước</div>
			</div>
			<div class="stat-card">
				<div class="stat-icon active">✅</div>
				<div class="stat-value">1,089</div>
				<div class="stat-label">Khách hàng hoạt động</div>
				<div class="stat-change">↗ +5% so với tháng trước</div>
			</div>
			<div class="stat-card">
				<div class="stat-icon inactive">⏸️</div>
				<div class="stat-value">145</div>
				<div class="stat-label">Khách hàng không hoạt động</div>
				<div class="stat-change">↘ -3% so với tháng trước</div>
			</div>
		</div>

		<!-- Thao tác nhanh -->
		<div class="actions-section">
			<h2 class="actions-title">Thao tác nhanh</h2>
			<div class="actions-grid">
				<a class="action-btn" href="@Url.Action("AddCustomer","ManageCustomer",new{area="Admin"})">
					<span>➕</span>
					Thêm khách hàng mới
				</a>
				<a class="action-btn" onclick="importCustomers()">
					<span>📥</span>
					Nhập khách hàng từ Excel
				</a>
				<a class="action-btn" onclick="exportCustomers()">
					<span>📤</span>
					Xuất danh sách khách hàng
				</a>
			</div>
		</div>

		<!-- Bảng đơn hàng -->
		<div class="customer_section-container">
			<div class="table-header">
				<h2 class="table-title">Danh sách đơn hàng</h2>
				<div class="active-filters" id="activeFilters" style="display: none;">
					<strong>Bộ lọc đang áp dụng:</strong>
					<div id="filterTags"></div>
				</div>

				<div class="sort-options">
					<label>Sắp xếp</label>
					<select class="sort-select" id="sortSelect" asp-items="Html.GetEnumSelectList<SortOptionsOrder>()" onchange="searchOrder()">
					</select>
				</div>

				<div class="search-container">
					<input type="text" class="search-input" placeholder="Tìm kiếm đơn hàng..." value="" id="searchInput">
					<button class="search-btn" onclick="searchOrder()">🔍 Tìm kiếm</button>
				</div>
			</div>

			<div class="table-content">
				<div class="filter-sidebar">
					<h3 style="margin-bottom: 20px; color: #2c3e50;">🔧 Bộ lọc</h3>

					<div class="filter-section">
						<div class="filter-title">🏭 Trạng thái</div>
						<select class="sort-select" id="stateSelect">
							<option value="">Tất cả</option>
							@foreach (var item in ViewBag.TrangThaiDonHang)
							{
								<option value="@item.MaTrangThai">@item.TenTrangThai</option>
							}
						</select>
					</div>

					<div class="filter-actions">
						<button class="btn-apply" onclick="applyFilters()">Áp dụng</button>
						<button class="btn-reset" onclick="resetFilters()">Đặt lại</button>
					</div>
				</div>

				<div class="order-table">
				</div>
			</div>
		</div>
	</div>

	<!-- Modal -->
	<div class="modal fade" id="detail_orderModal" tabindex="-1" aria-labelledby="detail_orderModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-lg">
			<div class="modal-content" id="modal-container">
			</div>
		</div>
	</div>
</div>
<script>
	document.addEventListener("DOMContentLoaded",()=>{
		searchOrder("init");
	})

	var detailOrder_modal = document.getElementById('detail_orderModal');
	detailOrder_modal.addEventListener('hide.bs.modal', function (event) {
	  applyFilters();
	});

	var model_container = document.getElementById("modal-container");

	var searchOrder = function(status)
	{
		var name = "";
		if(status!="init")
		{
			 showLoading("");
			 name =document.getElementById("searchInput").value;
		}

		var sort = document.getElementById("sortSelect").value;

		var tableProduct = document.getElementsByClassName("order-table")[0];

		$.ajax({
			url:"@Url.Action("FilterOrder", "ManageOrder", new { area = "Admin" })",
			method:"POST",
			data: {id: name, sortOption: sort},
			success:function(res)
			{
				hideLoading()
				tableProduct.innerHTML = res;
			},
			error: function(err)
			{
				hideLoading()
				console.log(err);
			}
		})
	}

	var applyFilters = function()
	{
		showLoading("");
		var name = document.getElementById("searchInput").value;
		var TrangThai = document.getElementById("stateSelect").value;
		var Sort = document.getElementById("sortSelect").value;

		var tableProduct = document.getElementsByClassName("order-table")[0];

		$.ajax({
			url:"@Url.Action("FilterOrder", "ManageOrder", new { area = "Admin" })",
			method:"POST",
			data: {keyword: name, state: TrangThai, sortOption: Sort},
			success:function(res)
			{
				hideLoading()
				tableProduct.innerHTML = res;
			},
			error: function(err)
			{
				hideLoading()
				console.log(err);
			}
		})
	}

	var resetFilters = function()
	{
		showLoading("");
		var TrangThai = document.getElementById("stateSelect");
		TrangThai.value = "";

		searchOrder();
	}

	var detailOrder=function(maDonHang)
	{
		$.ajax({
		url:"@Url.Action("DetailOrder", "ManageOrder", new { area = "Admin" })",
		method:"post",
		data: {maDh: maDonHang},
		success:function(res)
		{
			model_container.innerHTML=res;
		},
		error:function(res)
		{
		   console.log(res);
		}
		});
	}
	var sendOrder = function(maDonHang)
	{
		showLoading("");
		$.ajax({
		url:"@Url.Action("SendOrder", "ManageOrder", new { area = "Admin" })",
		method:"post",
		data: {maDh: maDonHang},
		success:function(res)
		{
			if(res.type="success")
			{
				detailOrder(maDonHang);
			}
			hideLoading();
			showToast(res.type, res.message);
		},
		error:function(res)
		{
		   hideLoading();
		   console.log(res);
		}
		});
	}
	var transferredOrder = function(maDonHang)
	{
		showLoading("");
		$.ajax({
		url:"@Url.Action("TransferredOrder", "ManageOrder", new { area = "Admin" })",
		method:"post",
		data: {maDh: maDonHang},
		success:function(res)
		{
			if(res.type="success")
			{
				detailOrder(maDonHang);
			}
			hideLoading();
			showToast(res.type, res.message);
		},
		error:function(res)
		{
		   hideLoading();
		   console.log(res);
		}
		});
	}
</script>
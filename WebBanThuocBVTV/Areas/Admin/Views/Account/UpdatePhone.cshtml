@{
}
<link href="~/css/Account/UpdatePhone.css" rel="stylesheet" />
<div class="updatePhone-container">
	<div class="card">
		<div class="card-header">
			<h4 class="mb-0">Quản lý tài khoản</h4>
			<small>Cập nhật số điện thoại</small>
		</div>

		<div class="card-body">
			<div>
				<!-- Phone Input -->
				<div class="mb-3">
					<label for="phone" class="form-label">Cập nhật số điện thoại</label>
					<div class="input-group">
						<select name="codeCountry" id="codeCountry" placeholder="Region">
							<option value="+1">United States</option>
							<option value="+44">United Kingdom</option>
						</select>
						<input name="phone" class="form-control" id="phone" placeholder="Nhập số điện thoại mới" value="@(ViewBag.Phone??"")" required>
						<button class="btn btn-success" id="btn-sendcode" type="button" onclick="sendOTP()">
							Gửi mã
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- Modal -->
	<div class="modal fade" id="verifyModal" tabindex="-1" aria-labelledby="verifyModalLabel" data-bs-backdrop="static" aria-hidden="true">
		<div class="modal-dialog modal-lg">
			<div class="modal-content" id="modal-container">
			</div>
		</div>
	</div>
</div>
<script src="~/js/Admin/Account/UpdatePhone.js"></script>
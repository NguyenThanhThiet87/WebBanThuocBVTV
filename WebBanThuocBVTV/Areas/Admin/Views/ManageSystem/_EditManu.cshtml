@model WebBanThuocBVTV.Models.Nhasanxuat

<link href="~/css/Admin/ManageSystem/_EditCategory.css" rel="stylesheet" />

<div class="modal-header">
	<h5 class="modal-title" id="customerModalLabel">
		<i class="fas fa-user-circle me-2"></i>
		<span id="modalTitle">Thông tin nhóm nhà sản xuất</span>
	</h5>
	<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body detail_order-body p-5">
	<div class="btn-group">
		<label for="maNhaSx">Mã nhà sản xuất:</label>
		<input id="maNhaSx" type="text" name="id" value="@Model.MaNhaSx" readonly />
	</div>
	<div class="btn-group">
		<label for="tenNhomSp">Tên nhà sản xuất:</label>
		<input id="tenNhomSp" type="text" name="name" value="@Model.TenNhaSx" required />
	</div>
</div>

<div class="modal-footer">
	<div class="view-mode">
		<button type="button" class="btn" id="sendButton" onclick="updateManu()">
			<i class="fas fa-edit me-2"></i>Cập nhật
		</button>
	</div>
</div>

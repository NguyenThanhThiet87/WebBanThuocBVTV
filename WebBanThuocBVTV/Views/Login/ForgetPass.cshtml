@{
}
<link href="~/css/Login/ForgetPass.css" rel="stylesheet" />
    <div class="forgetpass-container">
    <form class="forgot-password-form" asp-action="NhapMaOTP_Forget" asp-controller="Login">
            <h2>Quên mật khẩu</h2>
            <p>Nhập email hoặc số điện thoại của bạn để nhận liên kết đặt lại mật khẩu.</p>
            <input name="email" type="text" placeholder="Nhập email của bạn" required>
            <button type="submit">Gửi yêu cầu</button>
        <p><a asp-controller="Login" asp-action="Index">Quay lại</a></p>
        </form>
    </div>

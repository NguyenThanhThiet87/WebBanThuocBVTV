@{
}
<link href="~/css/Shared/_Header.css" rel="stylesheet" />
<div class="header-container">
    <div class="header">
        <!-- Logo -->
        <div class="logo">
            <div class="logo-circle">
                <div class="logo-inner">
                    <span class="logo-leaf">🌾</span>
                </div>
            </div>
            <div class="logo-text">
                AGRI MART<br>
                <small style="font-size: 10px; color: #666;">T&T</small>
            </div>
        </div>

        <!-- Search Box -->
        <div class="search-container">
            <input type="text" class="search-box" placeholder="Tìm kiếm sản phẩm...">
            <div class="search-icon"></div>
        </div>

        <!-- Header Items -->
        <div class="header-items">
            <a href="#" class="header-item">
                <div class="header-icon icon-location"></div>
                <div class="header-text">
                    Cửa hàng<br>
                    gần bạn
                </div>
            </a>

            <a href="#" class="header-item">
                <div class="header-icon icon-package"></div>
                <div class="header-text">
                    Theo dõi<br>
                    đơn hàng
                </div>
            </a>

            <a href="#" class="header-item">
                @* <div class="header-icon icon-cart"> *@
                    <i class="fa-light fa-cart-shopping" style="color: #069322;"></i>
                @* </div> *@
                <div class="header-text">
                    Giỏ hàng
                </div>
            </a>

            <a href="#" class="header-item">
                <div class="header-icon icon-user">

                </div>
                <div class="header-text">
                    Tài khoản<br>
                    Đăng nhập
                </div>
            </a>
        </div>
    </div>
</div>
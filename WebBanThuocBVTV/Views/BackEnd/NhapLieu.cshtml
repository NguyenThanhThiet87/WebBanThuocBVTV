@using WebBanThuocBVTV.Models
@{
	if ((bool?)ViewBag.Success == true)
	{
		<script>
			alert("Thanhcong");
		</script>
	}
	else
	{
		<script>
			alert("Thanhcong");
		</script>
	}
}

<form asp-action="ThemSp" asp-controller="BackEnd" method="post">
	<h2>NHẬP LIỆU SẢN PHẨM @ViewBag.countsp Sản phẩm</h2>
	<input type="text" oninput="handleFileSelect(this)" name="UrlImg"/>
	<img id="image" src="" width="200" height="200" style="background-color: black" />

	<ul>
		<li>
			<label for="tensp">Tên sản phẩm</label>
			<input id="tensp" type="text" name="TenSanPham"/>
		</li>
		<li class="input">
			<label for="thanhphan">Thành phần</label>
			<input id="thanhphan" type="text" name="ThanhPhan"/>
		</li>

		<li class="input">
			<label for="congdung">Công dụng</label>
			<input id="congdung" type="text" name="CongDung"/>
		</li>

		<li class="input">
			<label for="huongdan">Hướng dẫn sử dụng</label>
			<input id="huongdan" type="text" width="200" height="300" name="HuongDanSuDung"/>
		</li>

		<li class="input">
			<label for="gia">Gía</label>
			<input id="gia" type="text" name="Gia"/>
		</li>

		<li class="input">
			<label for="soluong">Số lượng</label>
			<input id="soluong" type="text" name="SoLuong"/>
		</li>
	</ul>

	<label for="nhomsp">Nhóm sản phẩm</label>
	<select name="MaNhomSp" id="nhomsp">
		@foreach (var item in ViewBag.listnsp)
		{
			<option value="@item.MaNhomSp">@item.TenNhomSp</option>
		}
	</select>
	<br />
	<label for="nsx">Nhà sản xuất</label>
	<select name="MaNhaSx" id="nsx">
		@foreach (var item in ViewBag.listnsx)
		{
			<option value="@item.MaNhaSx">@item.TenNhaSx</option>
		}
	</select>
	<input type="submit" width="50" height="50" style="background-color: gray; color: white" value="submit"/>
</form>
<style>
	input {
		width: 300px;
		height:75px;
	}
</style>

<script>
	function handleFileSelect(input) {
		document.getElementById('image').src =input.value;
	}
</script>